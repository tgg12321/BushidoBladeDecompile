/* The select-screen work area D_800A36A0 points at (func_800770B8 places it
 * just past the buffers func_8006E49C lays out). Two-element arrays are per
 * player. Per player, f48 is a list of f60 entries with cursor f5C; confirming
 * moves the entry under the cursor to f7E[f3C++], cancelling moves f7E[--f3C]
 * back into f48 in sorted order. f10/f14/f1C/f20/f3C are s16 pairs that the
 * original code also reads or clears as one word (union word views, owner
 * rulings Q33/Q46/Q57): func_800747D8 0x800747F4 and func_80075670 0x80075684
 * `lw 0x10`; func_80077374 `lw 0x14` (== 0x40004); func_800770B8 0x800772BC /
 * 0x800772C0 `sw $zero,0x20` / `sw $zero,0x1C`; func_80075F80 0x80076060
 * `lw 0x3C`. */
typedef struct {
    s32 f00;
    s32 *f04;
    s16 f08[2];
    s16 f0C[2];
    union {
        s16 half[2];
        s32 word;
    } f10;
    union {
        s16 half[2];
        s32 word;
    } f14;
    s16 f18[2];
    union {
        s16 half[2];
        s32 word;
    } f1C;
    union {
        s16 half[2];
        s32 word;
    } f20;
    u8 pad24[0xC];
    s32 f30;
    u16 f34;
    u16 f36;
    s16 f38[2];
    union {
        s16 half[2];
        s32 word;
    } f3C;
    s16 f40[2][2];
    s16 f48[2][5];
    s16 f5C[2];
    s16 f60[2];
    u8 f64;
    u8 f65;
    u8 f66;
    u8 f67;
    u8 f68[2];
    s16 f6A[2][5];
    s16 f7E[2][5];
} SelWork;

#define SELWORK ((SelWork *)D_800A36A0)
