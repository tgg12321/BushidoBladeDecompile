 tools/maspsx/maspsx/__init__.py         | 25 +++++++++++-------
 tools/maspsx/tests/test_comm_global.py  | 11 +++++---
 tools/maspsx/tests/test_static_lcomm.py | 35 +++++++++++++++++++++++++
