{
  "_doc": "Lane configuration for tools/lanes/lanes.py. Read from the MAIN checkout only.",
  "worktree_root": "../bb2-worktrees",
  "dir_prefix": "ln-",
  "branch_prefix": "lanes/",
  "remote": "origin",
  "stale_hours": 12,
  "lock_wait_minutes": 45,
  "oracle_sha1": "62efab4f73f992798c43e8c730aa43baa10bb4fa",
  "oracle_exe": "build/bb2.exe",
  "runner": "wsl",
  "_gate_mirror_doc": "Gates run in a throwaway clone at $HOME/<path> on the WSL ext4 disk, fetched read-only from main for the exact commit landed (lanes.py run_gates_mirror); copy = untracked toolchain copied from main when it is created. Rebuild: lanes.py gate-mirror --reset. After the gates the mirror also runs regenerate, input_checks and tip_checks (tools/lanes/mirror_post.py); the landing worktree applies only the regenerated files and must reach the mirror's trees. BB2_LANES_NO_MIRROR=1 runs all of it in the landing worktree instead.",
  "gate_mirror": {"path": "bb2-gate", "copy": ["tools/gcc-2.7.2", "tools/decomp-permuter", "tools/cc1psx.exe", "disc"]},
  "bootstrap": ["pwsh", "-NoProfile", "-File", "tools/setup_worker_worktree.ps1"],
  "shared_paths": [
    "include/game.h",
    "include/bb2.h",
    "named_syms.txt",
    "undefined_syms_auto.txt",
    "undefined_funcs_auto.txt",
    "symbol_addrs.txt",
    "bb2.ld",
    "Makefile",
    "inline_asm_canonical.txt",
    "docs/naming/function-names.csv",
    "docs/naming/phase3/backlog.tsv",
    "docs/foundation/backlog.tsv"
  ],
  "rowmerge": [
    "docs/naming/phase3/backlog.tsv",
    "docs/foundation/backlog.tsv",
    "docs/naming/phase3/no_name.tsv"
  ],
  "input_checks": [
    {
      "cmd": "python3 tools/trace/store.py check-commit",
      "inputs": ["docs/naming/runtime/"]
    }
  ],
  "tip_checks": [
    {
      "cmd": "python3 tools/trace/scan/notes.py check",
      "inputs": ["docs/naming/runtime/matrix/", "tools/trace/scan/notes.py",
                 "tools/trace/scan/facts.py", "engine/tus.py", "bb2.ld",
                 "src/main/psxsdk/libapi/c67.c", "docs/naming/runtime/evidence/"]
    }
  ],
  "regenerate": [
    {
      "path": "docs/naming/function-names.csv",
      "cmd": "python3 docs/naming/build_census.py",
      "subject": "docs: census refresh"
    },
    {
      "path": "docs/naming/runtime/evidence/events.tsv",
      "cmd": "python3 tools/trace/scan/events.py build",
      "subject": "docs: runtime event evidence refresh",
      "inputs": ["docs/naming/runtime/", "tools/trace/scan/events.py"]
    },
    {
      "path": "docs/naming/runtime/evidence/main__596CC.tsv",
      "cmd": "python3 tools/trace/scan/notes.py build --tu main/596CC",
      "subject": "docs: runtime evidence notes refresh (main/596CC)",
      "inputs": ["docs/naming/runtime/matrix/", "tools/trace/scan/notes.py",
                 "tools/trace/scan/facts.py", "engine/tus.py", "bb2.ld"]
    },
    {
      "path": "docs/naming/runtime/evidence/main__64FD8.tsv",
      "cmd": "python3 tools/trace/scan/notes.py build --tu main/64FD8",
      "subject": "docs: runtime evidence notes refresh (main/64FD8)",
      "inputs": ["docs/naming/runtime/matrix/", "tools/trace/scan/notes.py",
                 "tools/trace/scan/facts.py", "engine/tus.py", "bb2.ld",
                 "src/main/psxsdk/libapi/c67.c"]
    },
    {
      "path": "docs/naming/runtime/evidence/only_x.tsv",
      "cmd": "python3 tools/trace/scan/diff.py build",
      "subject": "docs: runtime only-X evidence refresh",
      "inputs": ["docs/naming/runtime/", "tools/trace/scan/diff.py",
                 "tools/trace/scan/facts.py", "tools/trace/runkit.py", "tools/trace/gdbtrace.py"]
    },
    {
      "path": "docs/naming/runtime/evidence/only_x_sets.tsv",
      "cmd": "python3 tools/trace/scan/diff.py build",
      "subject": "docs: runtime only-X evidence refresh",
      "inputs": ["docs/naming/runtime/", "tools/trace/scan/diff.py",
                 "tools/trace/scan/facts.py", "tools/trace/runkit.py", "tools/trace/gdbtrace.py"]
    },
    {
      "path": "docs/naming/runtime/evidence/screens.tsv",
      "cmd": "python3 tools/trace/scan/screens.py build",
      "subject": "docs: runtime screen evidence refresh",
      "inputs": ["docs/naming/runtime/", "tools/trace/scan/screens.py",
                 "tools/trace/scan/events.py", "tools/trace/runkit.py", "tools/trace/gdbtrace.py"]
    }
  ],
  "gates": {
    "naming": [
      "python3 -m engine.cli verify-oracle --rebuild",
      "python3 -m engine.cli tus-check",
      "python3 tools/check_completion_integrity.py",
      "python3 -m engine.cli test",
      "python3 tools/test_label_census.py"
    ],
    "foundation": [
      "python3 -m engine.cli verify-oracle --rebuild",
      "python3 -m engine.cli tus-check",
      "python3 tools/check_completion_integrity.py",
      "python3 -m engine.cli test"
    ],
    "docs": []
  },
  "_gate_scope_doc": "Per-gate scope (lanes.py scope_gates): a gate is skipped when every changed path is under its light entries, or the rest are under its renames entries and token_only_rename() proves a token-level rename whose old names occur nowhere under unread_by (git pathspecs). Entries: 'dir/' prefix, glob with '*', else one file. Gates not listed always run.",
  "gate_scope": {
    "python3 -m engine.cli test": {
      "light": ["docs/", "memory/", ".claude/", "tools/trace/scenarios/*.json"],
      "renames": ["src/", "include/", "asm/", "symbol_addrs.txt", "named_syms.txt",
                  "undefined_syms_auto.txt", "undefined_funcs_auto.txt"],
      "unread_by": ["engine/", "tools/", ":(top,glob)*.txt", ":!tools/trace/scenarios/*.json",
                    ":!symbol_addrs.txt", ":!named_syms.txt", ":!undefined_syms_auto.txt",
                    ":!undefined_funcs_auto.txt"]
    },
    "python3 tools/check_completion_integrity.py": {
      "light": [".claude/", "tools/trace/scenarios/*.json"]
    }
  },
  "docs_only_paths": ["docs/", "memory/", "tools/trace/scenarios/*.json"],
  "inert_paths": ["docs/", "memory/", ".claude/", "tools/trace/", "tools/lanes/"],
  "quick_gates": ["python3 -m engine.cli tus-check",
                  "python3 tools/check_completion_integrity.py"]
}
