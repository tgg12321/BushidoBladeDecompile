{
  "_doc": "Lane configuration for tools/lanes/lanes.py. Read from the MAIN checkout only.",
  "worktree_root": "../bb2-worktrees",
  "dir_prefix": "ln-",
  "branch_prefix": "lanes/",
  "remote": "origin",
  "stale_hours": 12,
  "lock_wait_minutes": 45,
  "oracle_sha1": "62efab4f73f992798c43e8c730aa43baa10bb4fa",
  "oracle_exe": "build/bb2.exe",
  "runner": "wsl",
  "bootstrap": ["pwsh", "-NoProfile", "-File", "tools/setup_worker_worktree.ps1"],
  "shared_paths": [
    "include/game.h",
    "include/bb2.h",
    "named_syms.txt",
    "undefined_syms_auto.txt",
    "undefined_funcs_auto.txt",
    "symbol_addrs.txt",
    "bb2.ld",
    "Makefile",
    "inline_asm_canonical.txt",
    "docs/naming/function-names.csv",
    "docs/naming/phase3/backlog.tsv",
    "docs/foundation/backlog.tsv"
  ],
  "rowmerge": [
    "docs/naming/phase3/backlog.tsv",
    "docs/foundation/backlog.tsv"
  ],
  "regenerate": [
    {
      "path": "docs/naming/function-names.csv",
      "cmd": "python3 docs/naming/build_census.py",
      "subject": "docs: census refresh"
    },
    {
      "path": "docs/naming/runtime/evidence/events.tsv",
      "cmd": "python3 tools/trace/scan/events.py build",
      "subject": "docs: runtime event evidence refresh",
      "inputs": ["docs/naming/runtime/", "tools/trace/scan/events.py"]
    },
    {
      "path": "docs/naming/runtime/evidence/main__596CC.tsv",
      "cmd": "python3 tools/trace/scan/notes.py build --tu main/596CC",
      "subject": "docs: runtime evidence notes refresh (main/596CC)",
      "inputs": ["docs/naming/runtime/matrix/", "tools/trace/scan/notes.py",
                 "tools/trace/scan/facts.py", "engine/tus.py", "bb2.ld"]
    },
    {
      "path": "docs/naming/runtime/evidence/main__64FD8.tsv",
      "cmd": "python3 tools/trace/scan/notes.py build --tu main/64FD8",
      "subject": "docs: runtime evidence notes refresh (main/64FD8)",
      "inputs": ["docs/naming/runtime/matrix/", "tools/trace/scan/notes.py",
                 "tools/trace/scan/facts.py", "engine/tus.py", "bb2.ld",
                 "src/main/psxsdk/libapi/c67.c"]
    },
    {
      "path": "docs/naming/runtime/evidence/only_x.tsv",
      "cmd": "python3 tools/trace/scan/diff.py build",
      "subject": "docs: runtime only-X evidence refresh",
      "inputs": ["docs/naming/runtime/", "tools/trace/scan/diff.py",
                 "tools/trace/scan/facts.py", "tools/trace/runkit.py", "tools/trace/gdbtrace.py"]
    },
    {
      "path": "docs/naming/runtime/evidence/only_x_sets.tsv",
      "cmd": "python3 tools/trace/scan/diff.py build",
      "subject": "docs: runtime only-X evidence refresh",
      "inputs": ["docs/naming/runtime/", "tools/trace/scan/diff.py",
                 "tools/trace/scan/facts.py", "tools/trace/runkit.py", "tools/trace/gdbtrace.py"]
    }
  ],
  "gates": {
    "naming": [
      "python3 -m engine.cli verify-oracle --rebuild",
      "python3 -m engine.cli tus-check",
      "python3 tools/check_completion_integrity.py",
      "python3 -m engine.cli test",
      "python3 tools/test_label_census.py"
    ],
    "foundation": [
      "python3 -m engine.cli verify-oracle --rebuild",
      "python3 -m engine.cli tus-check",
      "python3 tools/check_completion_integrity.py",
      "python3 -m engine.cli test"
    ],
    "docs": []
  },
  "docs_only_paths": ["docs/", "memory/"],
  "inert_paths": ["docs/", "memory/", ".claude/"],
  "quick_gates": ["python3 -m engine.cli tus-check",
                  "python3 tools/check_completion_integrity.py"]
}
